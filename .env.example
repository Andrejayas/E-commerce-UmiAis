# ─────────────────────────────────────────────
# DATABASE (Supabase PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Get this from: Supabase Dashboard → Project Settings → Database → Connection String
# Use the "URI" format (not pooler) for Prisma migrate
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─────────────────────────────────────────────
# NEXTAUTH
# NEXTAUTH_SECRET: generate with → openssl rand -base64 32
# NEXTAUTH_URL: your app's base URL (http://localhost:3000 in dev)
# ─────────────────────────────────────────────
NEXTAUTH_SECRET="your-secret-key-minimum-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# WHATSAPP (public — safe to expose to browser)
# Format: country code + number, no spaces or dashes
# Example for Indonesia: 6281234567890
# ─────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"
